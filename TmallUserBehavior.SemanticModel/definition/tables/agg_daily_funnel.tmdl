table agg_daily_funnel
	lineageTag: 11966611-e098-48e3-9295-cc87b580cd1a

	measure '浏览用户数(日)' = SUM(agg_daily_funnel[browse])
		formatString: #,0
		lineageTag: 900c343c-e788-40a6-82d5-4046e1de45f0

	measure '加购用户数(日)' = SUM(agg_daily_funnel[cart])
		formatString: #,0
		lineageTag: 4eda05ba-229f-42cc-b45d-3595d21f6739

	measure '购买事件数(日)' = SUM(agg_daily_funnel[purchase])
		formatString: #,0
		lineageTag: 594a2601-2807-463f-8411-968d68b23206

	measure '浏览→加购率' = DIVIDE([加购用户数(日)], [浏览用户数(日)])
		formatString: 0.0%
		lineageTag: 387aa5c9-49ca-4981-83f1-7d9868d8633a

	measure '浏览→购买率' = DIVIDE([购买事件数(日)], [浏览用户数(日)])
