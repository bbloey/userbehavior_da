		lineageTag: afeb98f2-f500-46f7-b831-07991c256122

	measure '加购→购买率' = DIVIDE([购买事件数(日)], [加购用户数(日)])
		formatString: 0.0%
		lineageTag: c98a689f-ce1f-4e82-87e5-5b8bffccffe2

